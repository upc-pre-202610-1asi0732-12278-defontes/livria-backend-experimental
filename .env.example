# Copia a .env y ajusta valores locales.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;User ID=root;Password=TU_PASSWORD;
ConnectionStrings__DbName=livriadb_experimental

# IMPORTANTE: DefaultConnection NO debe incluir Database=... (solo server/user/password).
# Si user-secrets tiene Database=livriadb, borrarlo: dotnet user-secrets clear --project LivriaBackend

TokenSettings__Secret=change-me-to-a-long-random-secret-at-least-32-chars
